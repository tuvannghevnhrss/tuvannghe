{
  "compilerOptions": {
    /* ======== Mục tiêu biên dịch ======== */
    "target": "ES2020",                       // đủ mới để dùng Promise-allSettled, optional chaining…
    "lib": ["dom", "dom.iterable", "esnext"],

    /* ======== Chất lượng mã & kiểm tra ======== */
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,                           // Next.js tự lo emit

    /* ======== Module & bundler ======== */
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "preserve",

    /* ======== Tăng tốc ======== */
    "incremental": true,

    /* ======== Alias đường dẫn ======== */
    "baseUrl": ".",                           // 👈 BẮT BUỘC khi dùng "paths"
    "paths": {
      "@/*": ["./src/*"]                      // import '@/utils/…'
    },

    /* ======== Plugin Next.js ======== */
    "plugins": [{ "name": "next" }]
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "supabase/functions", "functions"]
}
